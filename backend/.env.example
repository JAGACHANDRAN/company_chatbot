# MongoDB Connection Settings
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=calispec

# List all 6 of your MongoDB collection names below (comma-separated or individually):
MONGODB_COLLECTIONS=collection_1, collection_2, collection_3, collection_4, collection_5, collection_6

# Or list individually:
MONGODB_COLLECTION_1=collection_1
MONGODB_COLLECTION_2=collection_2
MONGODB_COLLECTION_3=collection_3
MONGODB_COLLECTION_4=collection_4
MONGODB_COLLECTION_5=collection_5
MONGODB_COLLECTION_6=collection_6

# ========================================================
# PRIVACY & SECURITY MODE
# When true: confidential contact data is NEVER sent to external services.
# Disables external LLMs & embedding APIs, enforces deterministic responses,
# and restricts search to regex and MongoDB text-index search.
# Set to false only if using an approved local LLM (e.g. http://localhost:11434).
# ========================================================
PRIVACY_MODE=true

# Ollama Cloud / API Configuration
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
LLM_MODEL=gpt-oss:120b

# Embedding & Vector Search Settings
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
VECTOR_INDEX_NAME=vector_index
MONGODB_DATABASE=calispec
MONGODB_COLLECTION=dataset_records

# CORS Frontend Allowed Origin
FRONTEND_URL=http://localhost:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
