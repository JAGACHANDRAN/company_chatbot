# ==============================================================================
# Calispec AI Search Backend Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Connection
# ------------------------------------------------------------------------------
# Replace with your MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=calispec

# Comma-separated list of your MongoDB collection names to search across:
MONGODB_COLLECTIONS=collection_1, collection_2, collection_3, collection_4

# Alternatively, configure collections individually:
# MONGODB_COLLECTION_1=collection_1
# MONGODB_COLLECTION_2=collection_2
# MONGODB_COLLECTION_3=collection_3

# ------------------------------------------------------------------------------
# 2. Privacy & Security Mode
# ------------------------------------------------------------------------------
# When true: Zero confidential contact data or records are sent to external services.
# Disables external LLM and remote embedding APIs, enforces deterministic responses,
# and performs regex and MongoDB text-index searches.
PRIVACY_MODE=true

# ------------------------------------------------------------------------------
# 3. Authentication & Role-Based Access Control (RBAC)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens (Change this in production!)
JWT_SECRET=your-secure-production-jwt-secret-key-change-this-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# (Optional) Pre-configured Data Uploader / Admin Credentials:
# UPLOADER_EMAIL=admin@example.com
# UPLOADER_PASSWORD=your_secure_password

# Google OAuth 2.0 Credentials (Direct Integration)
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ------------------------------------------------------------------------------
# 4. LLM & Embedding Settings (Local or Cloud Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
LLM_MODEL=gpt-oss:120b

# Vector Search Settings (Used when PRIVACY_MODE=false)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
VECTOR_INDEX_NAME=vector_index
MONGODB_DATABASE=calispec
MONGODB_COLLECTION=dataset_records

# ------------------------------------------------------------------------------
# 5. Server & CORS Settings
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
HOST=0.0.0.0
PORT=8000
